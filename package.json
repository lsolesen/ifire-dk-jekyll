{
  "name": "ifire.dk",
  "version": "1.0.0",
  "description": "Official site for ifire.dk.",
  "repository": {
    "type": "git",
    "url": "git://github.com/lsolesen/ifire-dk-jekyll.git"
  },
  "keywords": [
    "jekyll",
    "gulp",
    "netlify"
  ],
  "author": "Lars Olesen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lsolesen/ifire-dk-jekyll/issues"
  },
  "devDependencies": {
    "browserify": "^16.5",
    "concurrently": "^9.2.4",
    "linkinator": "^6.1.2",
    "minipass": "2.7.0",
    "mocha": "^9.2",
    "onchange": "^7.1.0",
    "serve": "^14.2.6",
    "uglify-js": "^3.13",
    "uglifyify": "^5.0.2",
    "watchify": "^4.0"
  },
  "scripts": {
    "test:links": "linkinator http://localhost:4040 --skip '^(?!http://localhost)' --recurse --silent --concurrency 100",
    "test:external": "bundle exec htmlproofer ./_site --only-4xx --ignore-status-codes '400,401,402,403,406,409,429,999' --ignore-empty-alt --allow-hash-href --no-enforce-https --check-internal-hash false --check-images false --check-scripts false --ignore-urls '/bjsm.bmj.com/,/mademistakes.com/,/www.t-nation.com/,/pubmed.ncbi.nlm.nih.gov/,/doi.org/' > broken_links.txt 2>&1",
    "check-links": "bundle exec htmlproofer ./_site --only-4xx --ignore-status-codes '400,401,402,403,406,409,429,999' --ignore-empty-alt --allow-hash-href --no-enforce-https --ignore-urls '/bjsm.bmj.com/,/mademistakes.com/,/www.t-nation.com/,/pubmed.ncbi.nlm.nih.gov/,/doi.org/' > broken_links.txt 2>&1",
    "start": "concurrently -k -n \"jekyll,serve\" -c \"blue,green\" \"npm run build:watch\" \"npm run serve:fast\"",
    "start:legacy": "bundle exec jekyll server --port 8080 --incremental",
    "serve:fast": "serve _site -l 4040",
    "build:watch": "bundle exec jekyll build --watch --incremental",
    "test:html": "bundle exec htmlproofer --only-4xx --assume-extension \".html\" --ignore-status-codes \"400,403,409,429\" --allow-hash-href --ignore-empty-alt --cache '{ \"timeframe\": { \"external\": \"7d\" } }' _site/",
    "generate-image": "node _scripts/generate-image.js",
    "og-image": "npm run generate-image -- type:og",
    "og-images": "npm run generate-image -- type:og path:./_posts/",
    "pinterest-image": "npm run generate-image -- type:pinterest",
    "pinterest-images": "npm run generate-image -- type:pinterest path:./_posts/",
    "instagram-image": "npm run generate-image -- type:instagram",
    "instagram-images": "npm run generate-image -- type:instagram path:./_posts/"
  }
}
